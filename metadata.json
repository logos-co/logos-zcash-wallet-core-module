{
  "name": "zcash_wallet_core_module",
  "display_name": "Zcash Wallet Core",
  "version": "0.2.0",
  "type": "core",
  "interface": "cdylib",
  "concurrency": "multi",
  "category": "wallet",
  "description": "Zcash wallet engine: librustzcash light client with keys sealed at rest, a SQLCipher database, and sync over Tor on a fixed download grid: the Tor that comes with Logos over IPC (tor_module), or the user's own. Answers only zcash_wallet_backend.",
  "author": "Logos Core Team",
  "main": "zcash_wallet_core_module_plugin",
  "dependencies": [
    { "name": "tor_module", "version": "~0.2.0" }
  ],
  "optional_dependencies": [
    { "name": "zebrad_module", "version": "~0.2.0" }
  ],
  "include": [
    "sapling-spend.params",
    "sapling-output.params"
  ],
  "capabilities": [],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "ZcashWalletCoreModule",
      "source": "src/glue.rs"
    }
  },
  "nix": {
    "rust": {
      "toolchain": "1.96.0",
      "packages": {
        "build": [
          "pkg-config",
          "perl"
        ],
        "runtime": []
      }
    },
    "external_libraries": [],
    "packages": {
      "build": [],
      "runtime": []
    },
    "cmake": {
      "find_packages": [],
      "extra_include_dirs": []
    }
  }
}
